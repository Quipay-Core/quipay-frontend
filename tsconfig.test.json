{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node", "jest"]
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/debug",
    "src/debug/**",
    "src/debug/**/*",
    "src/pages/Debugger.tsx",
    "src/pages/GovernanceOverview.tsx",
    "src/pages/StreamComparison.tsx",
    "src/pages/UIPrimitivesPreview.tsx",
    "src/components/NetworkHealthMonitor.tsx",
    "src/components/TransactionSimulationModal.tsx"
  ]
}
